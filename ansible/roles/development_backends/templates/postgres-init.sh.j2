#!/bin/sh
set -eu
# Only the fresh, isolated development volume runs this entrypoint script.
psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres \
  -v dev_password="$HOME_BUDGET_DEV_PASSWORD" <<'SQL'
CREATE ROLE home_budget_dev LOGIN PASSWORD :'dev_password' NOSUPERUSER NOCREATEDB NOCREATEROLE;
CREATE DATABASE home_budget_dev OWNER home_budget_dev;
REVOKE CONNECT ON DATABASE home_budget_dev FROM PUBLIC;
GRANT CONNECT ON DATABASE home_budget_dev TO home_budget_dev;
ALTER DATABASE home_budget_dev SET home_budget.environment = 'development';
SQL
