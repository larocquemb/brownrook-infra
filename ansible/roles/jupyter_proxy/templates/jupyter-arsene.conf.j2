# Managed by Ansible.
server {
    listen 80;
    server_name {{ jupyter_hostname }} {{ jupyter_internal_hostname }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ jupyter_hostname }};
    ssl_certificate {{ jupyter_certificate }};
    ssl_certificate_key {{ jupyter_certificate_key }};
    client_max_body_size 100m;

    location / {
        proxy_pass http://{{ jupyter_backend_ip }}:{{ jupyter_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600;
    }
}

server {
    listen 443 ssl;
    server_name {{ jupyter_internal_hostname }};
    ssl_certificate {{ jupyter_internal_certificate }};
    ssl_certificate_key {{ jupyter_internal_key }};
    client_max_body_size 100m;

{% for source in jupyter_internal_allowed_sources %}
    allow {{ source }};
{% endfor %}
    allow 127.0.0.1;
    deny all;

    location / {
        proxy_pass http://{{ jupyter_backend_ip }}:{{ jupyter_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600;
    }
}
